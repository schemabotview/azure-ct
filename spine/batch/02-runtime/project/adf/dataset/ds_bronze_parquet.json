{
  "name": "ds_bronze_parquet",
  "properties": {
    "type": "Parquet",
    "linkedServiceName": {
      "referenceName": "ls_lake",
      "type": "LinkedServiceReference"
    },
    "parameters": {"folder": {"type": "string"}, "file": {"type": "string"}},
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "bronze",
        "folderPath": {"value": "@dataset().folder", "type": "Expression"},
        "fileName": {"value": "@dataset().file", "type": "Expression"}
      },
      "compressionCodec": "snappy"
    }
  }
}
