{
  "name": "ds_landing_csv",
  "properties": {
    "type": "DelimitedText",
    "linkedServiceName": {
      "referenceName": "ls_lake",
      "type": "LinkedServiceReference"
    },
    "parameters": {"folder": {"type": "string"}, "file": {"type": "string"}},
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "landing",
        "folderPath": {"value": "@dataset().folder", "type": "Expression"},
        "fileName": {"value": "@dataset().file", "type": "Expression"}
      },
      "columnDelimiter": ",",
      "firstRowAsHeader": true
    }
  }
}
